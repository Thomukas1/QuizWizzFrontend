# Copy to `.env.local` and fill in. Vite only exposes VITE_-prefixed vars to
# client code, so the prefix is mandatory rather than decorative.

# The game server's base URL. HTTP doors live under `${VITE_API_URL}/quizwizz`.
VITE_API_URL=http://localhost:5000

# The socket. Optional — defaults to VITE_API_URL with http→ws and
# `/quizwizz/socket` appended, which is correct wherever the two share a host.
# VITE_WS_URL=ws://localhost:5000/quizwizz/socket

# ── Testing with real phones ──────────────────────────────────────────────
# Point BOTH at the dev machine's LAN IP, not localhost — a phone resolving
# `localhost` resolves itself. Run Vite with `--host` so it binds beyond
# loopback. The server already allows 192.168.* origins.
#
#   VITE_API_URL=http://192.168.1.42:5000
